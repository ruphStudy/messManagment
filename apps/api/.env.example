NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://postgres@localhost:5432/mess_management?schema=public

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3100

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
REFRESH_SHORT_TTL_HOURS=12

# OTP / SMS. SMS_PROVIDER=console logs OTPs and is refused when NODE_ENV=production.
SMS_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Development only: include the OTP in the API response so the mobile app can show it.
OTP_DEV_ECHO=true
