# ── Required ─────────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgresql://postgres@localhost:5432/mess_management?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
# Comma-separated allowed browser origins (production: https web origin only)
CORS_ORIGINS=http://localhost:3100

# ── Optional (defaults shown) ────────────────────────────────────────────
PORT=4100
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
REFRESH_SHORT_TTL_HOURS=12

# OTP / SMS. Only `console` (logs OTPs) exists today; it is refused when NODE_ENV=production.
SMS_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Development only: include the OTP in API responses so the apps can show it. Refused in production.
OTP_DEV_ECHO=true

# Push: expo (Expo push service) | log (development: print to server log) | disabled (in-app only).
# Production: must be set explicitly to expo or disabled.
PUSH_PROVIDER=log
# EXPO_ACCESS_TOKEN=          # only if "enhanced push security" is enabled in the Expo project
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Daily subscription-expiry reminders (09:00 IST). Production: set explicitly; true on exactly one instance.
SCHEDULER_ENABLED=true

# Complaint photos on local disk. Production: absolute path on a persistent, backed-up volume,
# plus UPLOAD_STORAGE_PERSISTENT=true to confirm it (the API refuses to start otherwise).
UPLOAD_DIR=uploads
# Optional support contact shown on the owner "Billing & Subscription" screen
SUPPORT_EMAIL=
SUPPORT_PHONE=
# UPLOAD_STORAGE_PERSISTENT=true

# Production only: allow a localhost DATABASE_URL (e.g. DB on the same host) deliberately.
# ALLOW_LOCAL_DATABASE=true
