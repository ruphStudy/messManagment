generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  MESS_OWNER
  MESS_MANAGER
  MESS_STAFF
  STUDENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MessStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MealPlanStatus {
  ACTIVE
  INACTIVE
}

enum PlanDurationType {
  DAYS
  MONTHS
}

enum SubscriptionKind {
  NEW
  RENEWAL
  PLAN_CHANGE
}

/// Same values as the shared MealKey.
enum MealType {
  breakfast
  lunch
  dinner
}

enum AttendanceSource {
  QR
  MANUAL
}

enum AttendanceStatus {
  SERVED
  REVERSED
}

enum PauseStatus {
  ACTIVE
  CANCELLED
}

enum PauseSource {
  STUDENT
  MESS
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  RECORDED
  REVERSED
}

enum ExpenseStatus {
  RECORDED
  REVERSED
}

enum MessType {
  STUDENT_MESS
  PG_HOSTEL
  TIFFIN_SERVICE
  OTHER
}

enum FoodType {
  VEG
  VEG_NON_VEG
}

enum ClientType {
  WEB
  MOBILE
}

/// A person who can sign in. `role` is the account type; mess-specific roles live on MessMembership.
model User {
  id             String     @id @default(uuid()) @db.Uuid
  firstName      String     @db.VarChar(50)
  lastName       String?    @db.VarChar(50)
  mobile         String     @unique @db.VarChar(15)
  email          String?    @unique @db.VarChar(120)
  passwordHash   String?
  role           Role
  status         UserStatus @default(ACTIVE)
  emailVerified  Boolean    @default(false)
  mobileVerified Boolean    @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  ownedMesses      Mess[]           @relation("MessOwner")
  memberships      MessMembership[]
  sessions         Session[]
  studentProfiles  MessStudent[]
  recordedExpenses Expense[]        @relation("ExpenseRecordedBy")
  reversedExpenses Expense[]        @relation("ExpenseReversedBy")
  recordedPayments Payment[]        @relation("PaymentRecordedBy")
  reversedPayments Payment[]        @relation("PaymentReversedBy")
  servedMeals      MealAttendance[] @relation("ServedBy")
  reversedMeals    MealAttendance[] @relation("ReversedBy")
  createdPauses    MealPause[]      @relation("PauseCreatedBy")
  cancelledPauses  MealPause[]      @relation("PauseCancelledBy")

  @@map("users")
}

/// A mess business (tenant). All future business records must reference messId.
model Mess {
  id                   String     @id @default(uuid()) @db.Uuid
  ownerId              String     @db.Uuid
  name                 String     @db.VarChar(80)
  mobile               String     @db.VarChar(15)
  email                String?    @db.VarChar(120)
  messType             MessType   @default(STUDENT_MESS)
  foodType             FoodType   @default(VEG)
  address              String     @db.VarChar(200)
  city                 String     @db.VarChar(60)
  state                String     @db.VarChar(60)
  pincode              String     @db.VarChar(6)
  breakfastAvailable   Boolean    @default(false)
  lunchAvailable       Boolean    @default(true)
  dinnerAvailable      Boolean    @default(true)
  /// 24h "HH:mm"
  openingTime          String?    @db.VarChar(5)
  closingTime          String?    @db.VarChar(5)
  logoUrl              String?
  /// HH:mm (Asia/Kolkata): same-day pauses must be made before these times
  breakfastPauseCutoff String     @default("06:00") @db.VarChar(5)
  lunchPauseCutoff     String     @default("09:00") @db.VarChar(5)
  dinnerPauseCutoff    String     @default("16:00") @db.VarChar(5)
  /// Last receipt number issued by this mess (receipts are RCPT-YYYY-000123).
  receiptSequence      Int        @default(0)
  status               MessStatus @default(ACTIVE)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  owner             User                  @relation("MessOwner", fields: [ownerId], references: [id])
  memberships       MessMembership[]
  students          MessStudent[]
  mealPlans         MealPlan[]
  subscriptions     StudentSubscription[]
  menus             DailyMenu[]
  attendance        MealAttendance[]
  pauses            MealPause[]
  payments          Payment[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]

  @@index([ownerId])
  @@map("messes")
}

/// Links a team user (owner, manager, staff) to a mess. Students are linked through MessStudent instead.
model MessMembership {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  messId    String           @db.Uuid
  role      Role
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  mess Mess @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@unique([userId, messId])
  @@index([messId, role])
  @@map("mess_memberships")
}

/// A refresh-token session. Only a SHA-256 hash of the token secret is stored.
model Session {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @db.Uuid
  refreshTokenHash  String
  /// Hash of the token replaced by the last rotation; accepted briefly so parallel tabs don't log out.
  previousTokenHash String?
  rotatedAt         DateTime?
  /// "Remember me": persistent cookie on web.
  persistent        Boolean    @default(true)
  clientType        ClientType
  userAgent         String?    @db.VarChar(255)
  ipAddress         String?    @db.VarChar(64)
  expiresAt         DateTime
  lastUsedAt        DateTime   @default(now())
  revokedAt         DateTime?
  createdAt         DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// One-time password challenge for mobile-number login. The code is stored hashed.
model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  mobile     String    @db.VarChar(15)
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([mobile, createdAt])
  @@map("otp_challenges")
}

/// A student enrolled in a mess. Belongs to the mess; the optional `user` is the platform login account.
/// Invariant: when linked, `mobile` equals the linked user's mobile. Archiving never touches the user account.
model MessStudent {
  id                     String        @id @default(uuid()) @db.Uuid
  messId                 String        @db.Uuid
  userId                 String?       @db.Uuid
  firstName              String        @db.VarChar(50)
  lastName               String?       @db.VarChar(50)
  /// Normalized 10-digit Indian mobile number
  mobile                 String        @db.VarChar(15)
  email                  String?       @db.VarChar(120)
  collegeName            String?       @db.VarChar(120)
  courseName             String?       @db.VarChar(120)
  hostelOrPg             String?       @db.VarChar(120)
  localAddress           String?       @db.VarChar(200)
  parentName             String?       @db.VarChar(50)
  parentMobile           String?       @db.VarChar(15)
  emergencyContactName   String?       @db.VarChar(50)
  emergencyContactMobile String?       @db.VarChar(15)
  joiningDate            DateTime      @db.Date
  status                 StudentStatus @default(ACTIVE)
  notes                  String?       @db.VarChar(1000)
  archivedAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  mess            Mess                  @relation(fields: [messId], references: [id], onDelete: Cascade)
  user            User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptions   StudentSubscription[]
  mealAttendances MealAttendance[]
  mealPauses      MealPause[]
  payments        Payment[]

  /// One record per person per mess (archived records are restored, not duplicated).
  @@unique([messId, mobile])
  @@unique([messId, userId])
  @@index([messId, status, createdAt])
  @@index([mobile])
  @@index([userId])
  @@map("mess_students")
}

/// A reusable plan configuration offered by a mess. Never deleted once used; deactivate instead.
model MealPlan {
  id                String           @id @default(uuid()) @db.Uuid
  messId            String           @db.Uuid
  name              String           @db.VarChar(80)
  description       String?          @db.VarChar(300)
  /// Price in paise
  pricePaise        Int
  breakfastIncluded Boolean          @default(false)
  lunchIncluded     Boolean          @default(false)
  dinnerIncluded    Boolean          @default(false)
  durationType      PlanDurationType
  durationValue     Int
  /// Meals in a limited package; null = unlimited within validity
  mealCredits       Int?
  status            MealPlanStatus   @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  mess          Mess                  @relation(fields: [messId], references: [id], onDelete: Cascade)
  subscriptions StudentSubscription[]

  @@index([messId, status])
  @@map("meal_plans")
}

/// A dated assignment of a plan to a student. Plan details are snapshotted so later plan edits never rewrite history.
/// Status is derived from dates (UPCOMING / ACTIVE / EXPIRED); only cancellation is stored.
model StudentSubscription {
  id                   String           @id @default(uuid()) @db.Uuid
  messId               String           @db.Uuid
  studentId            String           @db.Uuid
  mealPlanId           String?          @db.Uuid
  kind                 SubscriptionKind @default(NEW)
  planName             String           @db.VarChar(80)
  planPricePaise       Int
  breakfastIncluded    Boolean
  lunchIncluded        Boolean
  dinnerIncluded       Boolean
  startDate            DateTime         @db.Date
  endDate              DateTime         @db.Date
  totalMealCredits     Int?
  remainingMealCredits Int?
  /// Sum of RECORDED payments (paise). Maintained only by PaymentsService inside the student lock.
  amountPaidPaise      Int              @default(0)
  cancelledAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  mess       Mess             @relation(fields: [messId], references: [id], onDelete: Cascade)
  student    MessStudent      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mealPlan   MealPlan?        @relation(fields: [mealPlanId], references: [id], onDelete: SetNull)
  attendance MealAttendance[]
  mealPauses MealPause[]
  payments   Payment[]

  @@index([messId, endDate])
  @@index([messId, startDate])
  @@index([studentId, startDate])
  @@index([mealPlanId])
  @@map("student_subscriptions")
}

/// The menu of one mess for one calendar date (Indian date). Informational only: it never reserves or deducts meals.
model DailyMenu {
  id                 String    @id @default(uuid()) @db.Uuid
  messId             String    @db.Uuid
  menuDate           DateTime  @db.Date
  breakfastItems     String[]
  lunchItems         String[]
  dinnerItems        String[]
  breakfastAvailable Boolean   @default(true)
  lunchAvailable     Boolean   @default(true)
  dinnerAvailable    Boolean   @default(true)
  breakfastNote      String?   @db.VarChar(200)
  lunchNote          String?   @db.VarChar(200)
  dinnerNote         String?   @db.VarChar(200)
  generalNote        String?   @db.VarChar(300)
  isPublished        Boolean   @default(false)
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  mess Mess @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@unique([messId, menuDate])
  @@index([messId, isPublished, menuDate])
  @@map("daily_menus")
}

/// One served meal. Source of truth for consumption; never deleted (reversal keeps the row).
model MealAttendance {
  id             String           @id @default(uuid()) @db.Uuid
  messId         String           @db.Uuid
  studentId      String           @db.Uuid
  subscriptionId String           @db.Uuid
  attendanceDate DateTime         @db.Date
  mealType       MealType
  source         AttendanceSource
  status         AttendanceStatus @default(SERVED)
  /// true while SERVED, NULL once reversed. Part of the unique key below, so at most one served row per
  /// student/date/meal can exist (NULLs are distinct), while reversed rows stay as history.
  servedMarker   Boolean?         @default(true)
  /// Whether this attendance used one meal credit (limited plans). Reversal restores it only if true.
  creditDeducted Boolean          @default(false)
  servedById     String?          @db.Uuid
  note           String?          @db.VarChar(200)
  reversedAt     DateTime?
  reversedById   String?          @db.Uuid
  reversalReason String?          @db.VarChar(200)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  mess         Mess                @relation(fields: [messId], references: [id], onDelete: Cascade)
  student      MessStudent         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscription StudentSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  servedBy     User?               @relation("ServedBy", fields: [servedById], references: [id], onDelete: SetNull)
  reversedBy   User?               @relation("ReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  @@unique([messId, studentId, attendanceDate, mealType, servedMarker])
  @@index([messId, attendanceDate, mealType])
  @@index([studentId, attendanceDate])
  @@index([subscriptionId])
  @@map("meal_attendance")
}

/// "This student will not eat this meal on this date." Never creates attendance or changes credits.
/// Kept as history when cancelled.
model MealPause {
  id             String      @id @default(uuid()) @db.Uuid
  messId         String      @db.Uuid
  studentId      String      @db.Uuid
  /// The subscription that covered this date when the pause was made (informational).
  subscriptionId String      @db.Uuid
  pauseDate      DateTime    @db.Date
  mealType       MealType
  status         PauseStatus @default(ACTIVE)
  /// true while ACTIVE, NULL once cancelled: with the unique key below, at most one active pause per meal.
  activeMarker   Boolean?    @default(true)
  source         PauseSource
  reason         String?     @db.VarChar(120)
  createdById    String?     @db.Uuid
  cancelledAt    DateTime?
  cancelledById  String?     @db.Uuid
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  mess         Mess                @relation(fields: [messId], references: [id], onDelete: Cascade)
  student      MessStudent         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscription StudentSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  createdBy    User?               @relation("PauseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy  User?               @relation("PauseCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@unique([messId, studentId, pauseDate, mealType, activeMarker])
  @@index([messId, pauseDate, mealType])
  @@index([studentId, pauseDate])
  @@map("meal_pauses")
}

/// Money received by the mess against one subscription. Never deleted; mistakes are reversed.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  messId            String        @db.Uuid
  studentId         String        @db.Uuid
  subscriptionId    String        @db.Uuid
  receiptNumber     String        @db.VarChar(30)
  amountPaise       Int
  method            PaymentMethod
  paymentDate       DateTime      @db.Date
  referenceNumber   String?       @db.VarChar(60)
  note              String?       @db.VarChar(200)
  status            PaymentStatus @default(RECORDED)
  /// Subscription balance right after this payment was recorded (for the receipt).
  balanceAfterPaise Int
  /// Client-generated key so a double-submitted form records only once.
  idempotencyKey    String?       @db.VarChar(64)
  recordedById      String?       @db.Uuid
  reversedAt        DateTime?
  reversedById      String?       @db.Uuid
  reversalReason    String?       @db.VarChar(200)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  mess         Mess                @relation(fields: [messId], references: [id], onDelete: Cascade)
  student      MessStudent         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscription StudentSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  recordedBy   User?               @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  reversedBy   User?               @relation("PaymentReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  @@unique([messId, receiptNumber])
  @@unique([messId, idempotencyKey])
  @@index([messId, paymentDate])
  @@index([messId, status, paymentDate])
  @@index([studentId, paymentDate])
  @@index([subscriptionId])
  @@map("payments")
}

/// Per-mess expense category. Defaults are created on first use; never deleted (deactivate instead).
model ExpenseCategory {
  id             String   @id @default(uuid()) @db.Uuid
  messId         String   @db.Uuid
  name           String   @db.VarChar(40)
  /// lower(trim(name)) — makes names unique per mess regardless of case.
  normalizedName String   @db.VarChar(40)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  mess     Mess      @relation(fields: [messId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([messId, normalizedName])
  @@map("expense_categories")
}

/// Money spent by the mess. Separate from student payments; mistakes are reversed, never deleted.
model Expense {
  id              String         @id @default(uuid()) @db.Uuid
  messId          String         @db.Uuid
  categoryId      String         @db.Uuid
  title           String         @db.VarChar(80)
  amountPaise     Int
  expenseDate     DateTime       @db.Date
  paymentMethod   PaymentMethod?
  vendorName      String?        @db.VarChar(80)
  referenceNumber String?        @db.VarChar(60)
  note            String?        @db.VarChar(200)
  status          ExpenseStatus  @default(RECORDED)
  recordedById    String?        @db.Uuid
  reversedAt      DateTime?
  reversedById    String?        @db.Uuid
  reversalReason  String?        @db.VarChar(200)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  mess       Mess            @relation(fields: [messId], references: [id], onDelete: Cascade)
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  recordedBy User?           @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  reversedBy User?           @relation("ExpenseReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  @@index([messId, expenseDate])
  @@index([messId, categoryId, expenseDate])
  @@index([messId, status, expenseDate])
  @@map("expenses")
}
