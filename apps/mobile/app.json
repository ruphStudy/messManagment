{
  "expo": {
    "name": "MessMate",
    "slug": "messmate",
    "scheme": "messmate",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.messmate.student",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.messmate.student",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MessMate to attach a photo to your complaint.",
          "cameraPermission": "Allow MessMate to take a photo for your complaint."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MessMate to scan student meal QR codes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
